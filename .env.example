# ============================================
# OpenAI API 配置（用于 LLM 内容分析）
# ============================================
# 支持 OpenAI 官方 API 或兼容的第三方服务（如 Azure OpenAI、本地部署的模型）
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="sk-your-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# ============================================
# 服务器配置
# ============================================
PORT=3001

# ============================================
# yt-dlp 配置（可选）
# 如果使用 scripts/install-deps.sh 安装，yt-dlp 会自动安装到 .venv/ 目录
# ============================================
# 代理设置（如果需要）
HTTPS_PROXY=http://proxy.example.com:8080

# yt-dlp 二进制文件路径（uv 安装后自动配置）
# 使用一键安装脚本后无需手动设置
# YT_DLP_BIN=.venv/bin/yt-dlp

# 浏览器 cookies（chrome, firefox, safari, brave 等）
# 需要先在浏览器中登录 X/Twitter，yt-dlp 会自动提取 cookies 用于下载受保护的视频
# YT_DLP_COOKIES_BROWSER=chrome
# yt-dlp tuning (ms and retries)
# `YTDLP_TIMEOUT_MS` sets the maximum time (in milliseconds) yt-dlp can take before being interrupted. Default: `120000`.
YTDLP_TIMEOUT_MS=120000
# `YTDLP_RETRIES` controls how many attempts yt-dlp makes before giving up. Default: `2`.
YTDLP_RETRIES=2
